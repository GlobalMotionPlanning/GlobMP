# Copy to paths.env (not in git) and set for your machine.
AB_ROOT=$AB_CODE                                 # runs/ (dynamics, training, evaluation) lives here
AB_PY=/path/to/envs/direct-d3il/bin/python       # env from DiRecT/environment.yml, completed by tools/setup_avoiding_gpu.py
AB_WEIGHTS=$AB_CODE/checkpoints/model_ema_10.pth # the diffusion planner every baseline samples from (ours, 500k steps)
