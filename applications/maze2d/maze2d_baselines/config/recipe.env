# The paper's settings (DiRecT's protocol, arXiv 2606.15359, App. D.1).
SEED=0
TRAIN_STEPS=500000        # what DiRecT and the paper report; DiRecT/configs/config.yaml defaults to 2,000,000
TRAIN_BATCH=256
EVAL_REPEATS=3            # trajectories behind the rollout figures; the tables quote DiRecT's 100-repeat metrics
SETTINGS="broad narrow"   # two keep-outs (broad) or six (narrow)
