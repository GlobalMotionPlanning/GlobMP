# Copy to paths.env (not in git) and set for your machine.
MB_ROOT=$MB_CODE                                  # runs/ (dynamics model, training logs, evaluation outputs) lives here
MB_PY=/path/to/envs/direct-maze2d/bin/python      # env from DiRecT/environment.yml, completed by tools/setup_maze2d_gpu.py
D4RL_DATASET_DIR=$HOME/.d4rl/datasets             # maze2d-large-sparse-v1.hdf5 (tools/setup_maze2d_gpu.py downloads it)
MB_WEIGHTS=$MB_CODE/checkpoints/last.ckpt         # the diffusion planner every baseline samples from (ours, 500k steps);
                                                  # train/train_diffuser.sh writes runs/maze2d-diffuser/train/checkpoints/last.ckpt
