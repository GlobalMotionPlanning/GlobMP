# Training recipe. Frozen: these are the settings every reported result used.
SEED=1000
SAVE_STEPS=5000
# GR00T-N1.7-3B (1 GPU)
GROOT_STEPS=10000; GROOT_BATCH=16; GROOT_WORKERS=4
GROOT_STAGGER_S=150          # 2nd GR00T run on the same task starts later: both write meta stats on first use
# pi0.5
PI05_STEPS=10000; PI05_BATCH=8; PI05_CHUNK=100; PI05_WORKERS=8
# Tactile-VLA (pi0.5 recipe + MLP tactile prefix token over the last TVLA_HISTORY tactile frames)
TVLA_HISTORY=4
# Diffusion Policy
DP_STEPS=10000; DP_BATCH=64; DP_CHUNK=96; DP_WORKERS=24
# ACT
ACT_STEPS=5000; ACT_BATCH=64; ACT_CHUNK=100; ACT_WORKERS=24
# T-Rex (4 GPUs x batch 16, from midtrain)
TREX_STEPS=10000; TREX_BATCH_PER_GPU=16; TREX_LR=1e-4; TREX_CHUNK=16; TREX_ACTION_DIM=42; TREX_TACF_DIM=3
# Data split
SPLIT_EVERY=10               # every10: episode i held out when i % 10 == 0
SPLIT_TRAIN_N=100            # train100: exactly 100 train, held-out spread evenly (np.linspace)
LOADER_WORKERS_PER_GPU=8      # DP/ACT on several GPUs (speed only; does not change results)
# ViTacFormer (from ImageNet ResNet-18; 4 GPUs x 16 = the original per-GPU batch; GT future tactile for the first 75/2000 of the steps)
VTF_STEPS=10000; VTF_BATCH=64; VTF_LR=1e-4; VTF_CHUNK=100; VTF_WORKERS_PER_GPU=12
# Reactive Diffusion Policy (from scratch). Stage 1 AT on 1 GPU; stage 2 LDP: total batch split over GPUs, lr not scaled
RDP_AT_STEPS=40000; RDP_AT_BATCH=64; RDP_STEPS=10000; RDP_BATCH=64; RDP_WORKERS_PER_GPU=12
