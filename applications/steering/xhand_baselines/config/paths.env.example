# Copy to paths.env (not in git) and set for your machine.
XB_ROOT=/path/to/xhand_bench                 # data/ and runs/ live here
XB_RAW=/path/to/teleop                       # raw sessions, read-only (h5 + mp4 + result.json per episode)
XB_PY=/path/to/env/bin/python                # LeRobot 0.4.4 env: data prep, DP, ACT, eval, T-Rex
XB_PY_PI=/path/to/env_pi/bin/python          # LeRobot 0.4.4 env with pi0.5 deps
GR00T_DIR=$XB_CODE/GR00T                    # GR00T (NVIDIA GR00T N1.7, team fork) in this repo; create its .venv with GR00T/setup.sh
TREX_DIR=$XB_CODE/T-Rex                     # T-Rex with XHand support, in this repo
XB_PI05_BASE=$XB_CODE/pi05/base_model             # pi05/download_base.sh
XB_QWEN=$XB_CODE/T-Rex/checkpoints/Qwen3-VL-2B-Instruct   # T-Rex backbone (T-Rex/scripts/download_checkpoints.sh)
XB_TREX_MIDTRAIN=$XB_CODE/T-Rex/checkpoints/midtrain    # T-Rex midtrain checkpoint (same script)
TMPDIR=/tmp
VTF_DIR=$XB_CODE/ViTacFormer                # ViTacFormer with XHand support, in this repo
RDP_DIR=$XB_CODE/RDP                        # Reactive Diffusion Policy with XHand support, in this repo
RDP_SITE=$XB_CODE/RDP/extra_packages             # RDP-only packages on top of XB_PY (RDP/install_extra_packages.sh)
