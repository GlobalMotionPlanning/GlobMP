# Copy to paths.env (not in git) and set for your machine.
RB_ROOT=$RB_CODE                     # runs/ (per-cell results, logs, the flattened models) lives here
CONDA_BASE=$HOME/miniconda3          # where the envs are (the suite's config/envs/{direct,smd}.yml); or set:
# PY_DIRECT=/path/to/envs/direct/bin/python
# PY_SMD=/path/to/envs/smd/bin/python
# RB_MODELS=$RB_ROOT/runs/trained_models   # to run on models you retrained (default: checkpoints/, the paper's)
