# Copy to paths.env (not in git) and set for your machine.
SB_ROOT=$SB_CODE                       # runs/ (grid state, logs, per-cell results, the flattened models) lives here
CONDA_BASE=$HOME/miniconda3            # where the three envs (config/envs/*.yml) are; or set each interpreter:
# PY_DIRECT=/path/to/envs/direct/bin/python   # DiRecT, CD, Final Proj., MMD-CBS, PCD-LB, PCD-SHD, Diffusion Policy
# PY_MDOC=/path/to/envs/mdoc/bin/python       # MDOC (torch 2.4)
# PY_SMD=/path/to/envs/smd/bin/python         # data generation, training, the dispatcher, the checks
# SB_MODELS=$SB_ROOT/runs/trained_models      # to run the baselines on models you retrained (default: checkpoints/)
